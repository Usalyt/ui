{
  "name": "usalyt",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "pnpm --filter @usalyt/ui test:unit",
    "test:unit": "pnpm --filter @usalyt/ui test:unit",
    "test:watch": "pnpm --filter @usalyt/ui test:watch",
    "test:coverage": "pnpm --filter @usalyt/ui test:coverage",
    "test:e2e": "pnpm --filter @usalyt/tests test:e2e",
    "test:integration": "pnpm --filter @usalyt/tests test",
    "build:registry": "pnpm --filter @usalyt/registry build",
    "test:registry": "pnpm --filter @usalyt/registry test",
    "test:cli": "pnpm --filter @usalyt/cli test",
    "test:mcp": "pnpm --filter @usalyt/mcp-server test",
    "test:configs": "pnpm --filter @usalyt/tsconfig test && pnpm --filter @usalyt/eslint-config test",
    "test:installed": "node scripts/verify-installed.mjs",
    "pack:public": "node scripts/pack-public-packages.mjs",
    "check": "pnpm type-check && pnpm test:unit && pnpm test:integration && pnpm test:registry && pnpm test:cli && pnpm test:mcp && pnpm test:configs && pnpm build:registry && pnpm --filter @usalyt/ui build && pnpm --filter @usalyt/ui verify:artifacts:strict"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
