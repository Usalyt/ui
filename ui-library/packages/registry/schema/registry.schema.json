{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usalyt:registry-schema:0.0.1",
  "title": "Usalyt component registry",
  "description": "Schema for the packaged @usalyt/registry registry.json data file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "version",
    "license",
    "repository",
    "dependencyLicenses",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "./schema/registry.schema.json",
      "description": "Local schema reference relative to the packaged registry.json."
    },
    "name": {
      "const": "usalyt"
    },
    "version": {
      "const": "0.0.1"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "directory"],
      "properties": {
        "type": {
          "const": "git"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencyLicenses": {
      "$ref": "#/$defs/licenseMap"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "license": {
      "const": "GPL-3.0-only"
    },
    "auditedLicense": {
      "enum": ["Apache-2.0", "ISC", "MIT", "OFL-1.1"]
    },
    "licenseMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/auditedLicense"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(components/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9._-]+|blocks/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9._-]+|lib/[A-Za-z0-9._-]+)$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "content"],
      "properties": {
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "type": {
          "enum": ["registry:ui", "registry:block", "registry:lib"]
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "title",
        "description",
        "license",
        "dependencies",
        "devDependencies",
        "registryDependencies",
        "dependencyVersions",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": ["registry:ui", "registry:block", "registry:lib"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "dependencies": {
          "$ref": "#/$defs/stringList"
        },
        "devDependencies": {
          "$ref": "#/$defs/stringList"
        },
        "registryDependencies": {
          "$ref": "#/$defs/stringList"
        },
        "dependencyVersions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  }
}
